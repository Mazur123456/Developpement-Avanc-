<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console Appender avec format structuré -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Niveau de log pour l'application -->
    <logger name="org.univ_paris8.iut.montreuil.qdev.tp2025.gr.tpjee" level="DEBUG" />

    <!-- Niveau de log pour Hibernate (SQL) -->
    <logger name="org.hibernate.SQL" level="DEBUG" />
    <logger name="org.hibernate" level="WARN" />

    <!-- Niveau de log pour Jersey -->
    <logger name="org.glassfish.jersey" level="WARN" />

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>
